# SwiftPM and local build products
/.build/
/.swiftpm/
/build/
/dist/
/DerivedData/

# Local captures, benchmarks, process dumps, and diagnostic logs.
# Curated documentation media and validation results live under docs/ and are tracked.
/artifacts/

# Xcode user state and generated diagnostics
xcuserdata/
*.xcuserstate
*.hmap
*.dSYM/
*.dSYM.zip
*.xcresult/
*.profraw
*.profdata

# Python helper caches
__pycache__/
*.pyc
*.pyo

# macOS metadata and editor temporary files
.DS_Store
._*
*.swp
*.swo
*~

# Keep Package.resolved, Resources/, docs/media/, docs/validation/, and the
# shared .codex/environments/environment.toml configuration in version control.
